APP_NAME="DocMind RAG"
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8001

MODEL_MODE=real

LLM_API_KEY=CHANGE_ME
LLM_ENDPOINT=https://your-provider-endpoint
LLM_MODEL=your-llm-model

EMBEDDING_API_KEY=CHANGE_ME
EMBEDDING_ENDPOINT=https://your-provider-endpoint
EMBEDDING_MODEL=your-embedding-model

MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=1

DATA_DIR=/app/runtime

CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=3
MAX_DISTANCE=CHANGE_ME

CONTEXT_MAX_CHARS=7000
MAX_UPLOAD_MB=10
EMBED_BATCH_SIZE=32

CHROMA_COLLECTION=docmind_chunks